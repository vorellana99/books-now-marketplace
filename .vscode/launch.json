{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug main-api",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["run", "start:debug"],
        "cwd": "${workspaceFolder}/apps/main-api",
        "console": "integratedTerminal",
        "restart": true,
        "autoAttachChildProcesses": true,
        "skipFiles": ["<node_internals>/**", "node_modules/**"]
      }
    ]
  }