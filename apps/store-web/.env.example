# Dónde está la API. Con el valor por defecto (`/api`), en desarrollo el servidor de Vite reenvía `/api/*` al
# backend (ver VITE_API_PROXY_TARGET). En producción, el mismo origen detrás de un proxy inverso.
VITE_API_BASE_URL=/api

# Solo desarrollo: a dónde reenvía el proxy de Vite
VITE_API_PROXY_TARGET=http://localhost:3000

# Solo para `vp run api:types` (no se lee de este archivo): `API_DOCS_URL=http://… vp run api:types`
# Por defecto lee http://localhost:3000/docs-json, con el backend levantado
