DB_HOST=localhost
DB_PORT=5433                     # 5433 con Docker; con tu PostgreSQL local, el tuyo (normalmente 5432)
DB_USER=libroya
DB_PASSWORD=libroya
DB_NAME=libroya
PORT=3000
PAYMENT_PROVIDER=fake            # fake | external
PAYMENT_API_URL=
PAYMENT_SIMULATED_DELAY_MS=3000  # solo con fake: lo que tarda la pasarela simulada en cobrar y reembolsar (0 = sin demora)
EMAIL_SIMULATED_DELAY_MS=3000    # lo que tarda el correo simulado en "enviarse" (0 = sin demora)
JWT_SECRET=                      # secreto de los tokens (≥ 32 caracteres variados): `openssl rand -base64 48`. Obligatorio en producción; sin él, en desarrollo se usa uno aleatorio por proceso
ACCESS_TOKEN_TTL_SECONDS=900     # vida del token de acceso: 15 minutos (de 60 a 3600)
REFRESH_TOKEN_TTL_DAYS=14        # días que vale un token de refresco sin usarse (de 1 a 90); cada uso entrega uno nuevo
CORS_ORIGINS=                    # orígenes que pueden llamar a la API desde un navegador, separados por comas (https://app.libroya.pe,http://localhost:5173). Vacía: sin CORS. En producción, solo https
TRUST_PROXY=0                    # cuántos proxies hay delante de la API (0 = ninguno): de ahí sale la dirección del cliente para el límite de intentos
RATE_LIMIT_WINDOW_SECONDS=60     # ventana del límite de intentos
RATE_LIMIT_LOGIN_IP=20           # intentos de login por dirección en la ventana
RATE_LIMIT_LOGIN_ACCOUNT=5       # intentos de login por correo en la ventana (lo bloquea de cualquier dirección)
RATE_LIMIT_REGISTER_IP=10        # registros por dirección en la ventana
RATE_LIMIT_REFRESH_IP=30         # renovaciones y cierres de sesión por dirección en la ventana
PASSWORD_HASH_LOG_N=15           # costo del hash de contraseñas (scrypt, N = 2^valor); en producción no puede ser menor que 15
OUTBOX_MAX_ATTEMPTS=8
CHECKOUT_RECOVERY_MINUTES=10     # debe superar la duración máxima del handler (no solo de la petición HTTP)
DB_STATEMENT_TIMEOUT_MS=5000     # límite de cada sentencia SQL; mantiene acotada la duración de la compra
# Cuántos días se guardan los datos ya terminados antes de purgarlos (cada noche, a las 3). Lo pendiente, en curso o fallido no se purga nunca
RETENTION_OUTBOX_DAYS=30         # mensajes del outbox con todas sus entregas hechas
RETENTION_CHECKOUT_DAYS=30       # checkouts COMPLETED o ABORTED; al purgarlos se olvida su Idempotency-Key, así que no lo bajes de lo que tarde un cliente en reintentar
RETENTION_RESERVATION_DAYS=90    # reservas CONFIRMED
RETENTION_REFRESH_TOKEN_DAYS=7   # tokens de refresco, tras vencer, usarse o revocarse
