DB_HOST=localhost
DB_PORT=5433                     # 5433 con Docker; con tu PostgreSQL local, el tuyo (normalmente 5432)
DB_USER=libroya
DB_PASSWORD=libroya
DB_NAME=libroya
PORT=3000
PAYMENT_PROVIDER=fake            # fake | external
PAYMENT_API_URL=
PAYMENT_SIMULATED_DELAY_MS=3000  # solo con fake: lo que tarda la pasarela simulada en cobrar y reembolsar (0 = sin demora)
EMAIL_SIMULATED_DELAY_MS=3000    # lo que tarda el correo simulado en "enviarse" (0 = sin demora)
JWT_SECRET=                      # secreto de los tokens (≥ 32 caracteres variados): `openssl rand -base64 48`. Obligatorio en producción; sin él, en desarrollo se usa uno aleatorio por proceso
ACCESS_TOKEN_TTL_SECONDS=900     # vida del token de acceso: 15 minutos (de 60 a 3600)
REFRESH_TOKEN_TTL_DAYS=14        # días que vale un token de refresco sin usarse (de 1 a 90); cada uso entrega uno nuevo
PASSWORD_HASH_LOG_N=15           # costo del hash de contraseñas (scrypt, N = 2^valor); en producción no puede ser menor que 15
OUTBOX_MAX_ATTEMPTS=8
CHECKOUT_RECOVERY_MINUTES=10     # debe superar la duración máxima del handler (no solo de la petición HTTP)
DB_STATEMENT_TIMEOUT_MS=5000     # límite de cada sentencia SQL; mantiene acotada la duración de la compra
ADMIN_API_ENABLED=false          # endpoints /admin solo en desarrollo, hasta tener autenticación
